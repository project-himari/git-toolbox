#=========================# Don't touch #=========================#

#Main code
if ($#argv == 0) then
    id | sed -e "s/)/)\n/g" -e "s/id=/id:/g" -e "s/=/\n/g" -e "s/,//g" | sed -e 's/^[ \t]*//g' | grep -1 -e "gid"
    id | sed -e "s/)/)\n/g" -e "s/id=/id:/g" -e "s/=/\n/g" -e "s/,//g" | sed -e 's/^[ \t]*//g' | grep -v -e "id" -e "groups" -e "所属グループ" -e '^$' | sort -r > $install_dir/menu.tmp
    
    bash $install_dir/func_menu.sh
    set enter_gid = `cat $install_dir/answer.tmp | awk '{print substr($0, index($0, "("), index($0, ")") -1 )}' | sed -e "s/(//g" -e "s/)//g"`
    if ("$enter_gid" == "") then
        rm -f $install_dir/menu.tmp $install_dir/answer.tmp >& /dev/null
        exit(0)
    endif
    
    rm -f $install_dir/menu.tmp $install_dir/answer.tmp >& /dev/null
    set sel_dir = `ls -la /workdata/ | grep -v -e "root root" -e "users" | sed -e "s/    / /g" -e "s/   / /g" -e "s/  / /g"  | grep -e "$enter_gid" | cut -d " " -f 10  | wc -l`
    set ent_dir = `ls -la /workdata/ | grep -v -e "root root" -e "users" | sed -e "s/    / /g" -e "s/   / /g" -e "s/  / /g"  | grep -e "$enter_gid" | cut -d " " -f 10 `
    if ($sel_dir == 0) then
        echo "ERROR:あなたの権限で入れる製品ディレクトリが見つかりませんでした。"
    else if ($sel_dir == 1) then
        echo $ent_dir
        cd /workdata/$ent_dir
        pwd
    else if ($sel_dir > 1) then
        echo "同じgidを持つ製品ディレクトリが2つ以上見つかりました。どちらのディレクトリにはいりますか?"
        ls -la /workdata/ | grep -v -e "root root" -e "users" | sed -e "s/    / /g" -e "s/   / /g" -e "s/  / /g"  | grep -e "$enter_gid" | cut -d " " -f 10 >  $install_dir/menu.tmp
        
        bash $install_dir/func_menu.sh
        set enter = `cat $install_dir/answer.tmp`
        if ($enter == "quit") then
            rm -f $install_dir/menu.tmp $install_dir/answer.tmp >& /dev/null
            exit(0)
        endif
        cd /workdata/$enter
    endif
    
    tree -L 3 -d -f | sed -e '/director/d' -e '/^$/d'|grep -e "composer" | sed -e 's/ //g' -e 's/--/@@/g' -e 's/|//g' | cut -c 3- | sed -e 's/|//g'  -e 's/@//g'  > $install_dir/menu.tmp
    set composer_count = `cat $install_dir/menu.tmp|wc -l`
    if ($composer_count == 0) then
        echo "ERROR:composerディレクトリが見つかりませんでした。"
        exit(0)
    else if ($composer_count == 1) then
        cd `tree -L 3 -d -f | sed -e '/director/d' -e '/^$/d'|grep -e "composer" | sed -e 's/ //g' -e 's/--/@@/g' -e 's/|//g' | cut -c 3- | sed -e 's/|//g'  -e 's/@//g' `
        printf "\033[35mCurrent Directory\033[m : `pwd`\n"
    else if ($composer_count > 1) then
        echo "composerが2つ以上見つかりました。どちらのcomposerに入りますか?"
        bash $install_dir/func_menu.sh
        set enter = `cat $install_dir/answer.tmp`
        if ($enter == "quit") then
            rm -f $install_dir/menu.tmp $install_dir/answer.tmp >& /dev/null
            exit(0)
        endif
        set composer = `cat $install_dir/answer.tmp`
        cd $composer ; printf "\033[35mCurrent Directory\033[m : `pwd`\n"
    endif
    printf "\033[33mgid changed\033[m : \033[35m$enter_gid\033[m\n"
    echo "1" > $install_dir/newgrp_flag.tmp
    newgrp $enter_gid
endif

if($#argv == 1) then
#newgrp after new cshrc
    if(-f $install_dir/newgrp_flag.tmp && "$argv[1]" == "-b") then
        if (`cat $install_dir/newgrp_flag.tmp` == 1) then
            rm  -f $install_dir/newgrp_flag.tmp >& /dev/null
find -maxdepth 1 -name '*cshrc*' > $install_dir/menu.tmp
            echo "読み込むcshrcを選択してください。"
            bash $install_dir/func_menu.sh
            set enter = `cat $install_dir/answer.tmp`
            if ($enter == "quit") then
                rm -f $install_dir/menu.tmp $install_dir/answer.tmp >& /dev/null
                exit(0)
                set cshrc_select = `cat $install_dir/answer.tmp`
                source $cshec_select
            endif
        endif
        exit(0)
    endif
endif

