#!/bin/bash
set -euo pipefail

ROOT="."
OUTDIR=""
SKIP=0
FORCE=0
MAXLEN=120
FLAT=0

usage() {
  cat <<'EOF'
Usage: epub2md.sh [-d ROOT] [-o OUTDIR] [-s] [-f] [--flat]
  -d ROOT   : search root (default: .)
  -o OUTDIR : output base dir (mirror structure under OUTDIR)
  -s        : skip if output md exists
  -f        : overwrite (ignore -s)
  --flat    : flatten media/ subdirs into media/ and rewrite md links
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -d) ROOT="${2:-}"; shift 2 ;;
    -o) OUTDIR="${2:-}"; shift 2 ;;
    -s) SKIP=1; shift ;;
    -f) FORCE=1; shift ;;
    --flat) FLAT=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "ERROR: Unknown option: $1" >&2; usage; exit 2 ;;
  esac
done

command -v pandoc >/dev/null 2>&1 || { echo "ERROR: pandoc not found" >&2; exit 2; }
command -v python3 >/dev/null 2>&1 || { echo "ERROR: python3 not found (needed for md rewrite)" >&2; exit 2; }
[[ -d "$ROOT" ]] || { echo "ERROR: root not found: $ROOT" >&2; exit 2; }

ROOT_ABS="$(cd "$ROOT" && pwd)"
OUTDIR_ABS=""
if [[ -n "$OUTDIR" ]]; then
  mkdir -p "$OUTDIR"
  OUTDIR_ABS="$(cd "$OUTDIR" && pwd)"
fi

sanitize() {
  local s="$1"
  s="${s// /_}"     # space -> _
  s="${s//\//_}"
  s="${s//:/_}"
  s="${s//&/_}"
  s="${s//$'\t'/_}"
  s="${s%%[ .]}"    # trim trailing space/dot
  if ((${#s} > MAXLEN)); then
    s="${s:0:MAXLEN}"
  fi
  printf '%s' "$s"
}

flatten_media_and_rewrite_md() {
  local book_dir="$1"
  local md_file="$2"
  local media_dir="$3"

  [[ -d "$media_dir" ]] || return 0

  local map_file
  map_file="$(mktemp)"

  # 1) media/配下のサブディレクトリ内ファイルをmedia直下に移動（衝突は連番）
  #    old path: media/xxx/yyy.png
  #    new path: media/yyy.png (or yyy_1.png ...)
  while IFS= read -r -d '' src; do
    local rel="${src#"$book_dir/"}"          # e.g. media/images/0001.jpg
    local base="$(basename "$src")"         # e.g. 0001.jpg
    local dest="$media_dir/$base"

    if [[ ! -e "$dest" ]]; then
      mv "$src" "$dest"
      printf '%s\t%s\n' "$rel" "media/$base" >>"$map_file"
    else
      # collision -> add _N before extension
      local stem="${base%.*}"
      local ext=""
      if [[ "$base" == *.* ]]; then ext=".${base##*.}"; fi
      local n=1
      while [[ -e "$media_dir/${stem}_${n}${ext}" ]]; do
        ((n++))
      done
      local newbase="${stem}_${n}${ext}"
      mv "$src" "$media_dir/$newbase"
      printf '%s\t%s\n' "$rel" "media/$newbase" >>"$map_file"
    fi
  done < <(find "$media_dir" -mindepth 2 -type f -print0)

  # 2) 空になったサブディレクトリを掃除
  find "$media_dir" -type d -empty -delete || true

  # 3) md内の参照を書き換え（old->new を全置換）
  #    Markdown: ![](media/images/0001.jpg)
  #    HTML: <img src="media/images/0001.jpg">
  python3 - "$md_file" "$map_file" <<'PY'
import sys, pathlib

md_path = pathlib.Path(sys.argv[1])
map_path = pathlib.Path(sys.argv[2])

text = md_path.read_text(encoding="utf-8", errors="ignore")

# old \t new
pairs = []
for line in map_path.read_text(encoding="utf-8", errors="ignore").splitlines():
    if not line.strip():
        continue
    old, new = line.split("\t", 1)
    pairs.append((old, new))

# 長いものから先に置換（部分一致事故を減らす）
pairs.sort(key=lambda x: len(x[0]), reverse=True)

for old, new in pairs:
    # src="old" / src='old' / (old) / [old] など広く対応
    text = text.replace(f'src="{old}"', f'src="{new}"')
    text = text.replace(f"src='{old}'", f"src='{new}'")
    text = text.replace(f'({old})', f'({new})')
    text = text.replace(f'[{old}]', f'[{new}]')
    # 念のため素のoldも置換（副作用が嫌なら削ってOK）
    text = text.replace(old, new)

md_path.write_text(text, encoding="utf-8")
PY

  rm -f "$map_file"
}

echo "[epub2md] ROOT: $ROOT_ABS"
[[ -n "$OUTDIR_ABS" ]] && echo "[epub2md] OUT : $OUTDIR_ABS"
[[ "$FLAT" == "1" ]] && echo "[epub2md] FLAT: ON"

find "$ROOT_ABS" -type f -iname "*.epub" -print0 |
while IFS= read -r -d '' epub; do
  base="$(basename "$epub")"
  name="${base%.[eE][pP][uU][bB]}"
  safe="$(sanitize "$name")"

  rel="${epub#"$ROOT_ABS"/}"
  rel_dir="$(dirname "$rel")"

  if [[ -n "$OUTDIR_ABS" ]]; then
    book_dir="$OUTDIR_ABS/$rel_dir/$safe"
  else
    book_dir="$(dirname "$epub")/$safe"
  fi

  md="$book_dir/$safe.md"
  media_rel="media"
  media_dir="$book_dir/$media_rel"

  if [[ -f "$md" && "$FORCE" != "1" && "$SKIP" == "1" ]]; then
    echo "[skip] $md"
    continue
  fi
  if [[ -f "$md" && "$FORCE" != "1" && "$SKIP" == "0" ]]; then
    echo "[exists] $md (use -s to skip or -f to overwrite)"
    continue
  fi

  mkdir -p "$book_dir"

  echo "[conv] $epub -> $md"
  # 出力先で実行して、md内リンクを相対（media/...）にする
  ( cd "$book_dir" && pandoc "$epub" -t gfm --wrap=none --extract-media="$media_rel" -o "$safe.md" )

  if [[ "$FLAT" == "1" ]]; then
    flatten_media_and_rewrite_md "$book_dir" "$md" "$media_dir"
  fi
done

echo "Done."